{
  "name": "whatsapp-bot-revelar",
  "version": "1.0.0",
  "description": "WhatsApp Bot with view-once bypass and sticker commands",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "reset:admin": "node src/scripts/reset-admin.js",
    "db:ping": "node src/scripts/sync-supabase.js --ping",
    "db:init": "node src/scripts/sync-supabase.js --init",
    "db:push": "node src/scripts/sync-supabase.js --push",
    "db:pull": "node src/scripts/sync-supabase.js --pull",
    "db:check": "node src/scripts/sync-supabase.js --check",
    "db:status": "node src/scripts/sync-supabase.js --status",
    "dump:dry": "node src/scripts/dump-telegram.js --dry",
    "dump:send": "node src/scripts/dump-telegram.js --send",
    "audit:bundle": "node src/scripts/audit-bundle.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:slow": "node --test \"test-slow/*.test.js\""
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.6.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.6.7",
    "better-sqlite3": "^12.11.1",
    "cookie-session": "^2.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-webpmux": "^3.2.1",
    "opentype.js": "^1.3.4",
    "p-queue": "^9.3.0",
    "pino": "^9.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "yt-search": "^2.13.1"
  },
  "overrides": {
    "minimatch": "^3.1.3"
  }
}
